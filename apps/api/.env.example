# Copy to apps/api/.env for local development. Placeholder values only; never commit real secrets.
NODE_ENV=development
PORT=4000

# docker compose exposes PostgreSQL on host port 5433 by default (see root .env.example)
DATABASE_URL=postgresql://saas:saas_dev_password@localhost:5433/saas_dev?schema=public

# Public origin of the web app (used for email links). Also the default CORS/CSRF origin allowlist.
APP_URL=http://localhost:3000
# Comma-separated list of origins allowed to make credentialed, state-changing requests.
CORS_ORIGINS=http://localhost:3000

# Express "trust proxy": loopback | <number of hops> | true | false | comma-separated subnets
TRUST_PROXY=loopback

# Cookies. In production COOKIE_SECURE must be true; cookies then use the __Host- prefix.
COOKIE_SECURE=false
# COOKIE_DOMAIN=example.com

SESSION_IDLE_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_DAYS=30

# >= 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CSRF_SECRET=replace-with-a-long-random-secret-at-least-32-chars

REGISTRATION_ENABLED=true
SWAGGER_ENABLED=true
LOG_LEVEL=debug

# Mailpit from docker compose (web UI at http://localhost:8025). Required in production.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="SaaS Platform <no-reply@localhost>"

THROTTLE_TTL_SECONDS=60
THROTTLE_DEFAULT_LIMIT=300
THROTTLE_AUTH_LIMIT=10

# Development seed only: password for all seeded accounts.
SEED_PASSWORD=ChangeMe-dev-only-1
